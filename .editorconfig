# ─────────────────────────────────────────────────────────────────────────────
#  GPU-Center World Model — editor configuration
#  Author:  Yash Sharma · https://www.linkedin.com/in/yashsharmaa/
#  License: Apache-2.0
#
#  Cross-editor whitespace/encoding defaults so contributions stay ruff-clean
#  (line length 88) and consistent across Python, TypeScript, YAML, and docs.
# ─────────────────────────────────────────────────────────────────────────────
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Python — match ruff (line-length 88, 4-space indent).
[*.py]
indent_size = 4
max_line_length = 88

# TypeScript / JavaScript / JSON / web app — 2-space, conventional.
[*.{ts,tsx,js,jsx,mjs,cjs,json}]
indent_size = 2

# YAML / config — 2-space (required by YAML; used by workflows, dependabot).
[*.{yml,yaml}]
indent_size = 2

# TOML — 2-space.
[*.toml]
indent_size = 2

# Markdown — keep trailing whitespace (it encodes hard line breaks).
[*.md]
trim_trailing_whitespace = false
max_line_length = off

# Makefiles require literal tabs.
[Makefile]
indent_style = tab

# Shell scripts.
[*.sh]
indent_size = 2
