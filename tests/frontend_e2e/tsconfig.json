{
  "//": "GPU-Center World Model — Playwright e2e tsconfig · Author: Yash Sharma · https://www.linkedin.com/in/yashsharmaa/ · License: Apache-2.0",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true,
    "isolatedModules": true
  },
  "include": ["**/*.ts"]
}
