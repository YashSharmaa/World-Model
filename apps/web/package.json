    "@radix-ui/react-tooltip": "^1.2.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.454.0",
    "postprocessing": "^6.39.1",
    "react": "^19.2.7",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.1",
    "three": "^0.169.0"
